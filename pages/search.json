{%- comment -%} The Manifest's search (setup_note_list): each listed page's address and text, without
  its tags. The page loads it the first time its search box is used. {%- endcomment -%}
{%- include manifest-posts.html -%}
[
{%- for post in all_posts -%}
{"url": {{ post.url | relative_url | jsonify }}, "text": {{ post.content | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
